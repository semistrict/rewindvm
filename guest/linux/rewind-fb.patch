 /*
+ * Registers the monitor-reserved framebuffer region as a standard
+ * "simple-framebuffer" platform device so mainline Linux simpledrm exposes
+ * both /dev/dri/card0 (Wayland KMS) and /dev/fb0 (fbdev emulation).
+ */
+static int __init rewind_fb_init(void)
+{
+	u64 addr = READ_ONCE(rewind_shared.fb_addr);
+	u32 width = READ_ONCE(rewind_shared.fb_width);
+	u32 height = READ_ONCE(rewind_shared.fb_height);
+	u32 stride = READ_ONCE(rewind_shared.fb_stride);
+	u32 size = READ_ONCE(rewind_shared.fb_size);
+	struct resource res = {
+		.flags = IORESOURCE_MEM,
+		.start = addr,
+		.end = addr + PAGE_ALIGN(size) - 1,
+	};
+	struct simplefb_platform_data pdata = {
+		.width = width,
+		.height = height,
+		.stride = stride,
+		.format = "x8r8g8b8",
+	};
+	struct platform_device *pdev;
+
+	if (!addr || !width || !height || !stride || !size)
+		return 0;
+	pdev = platform_device_register_resndata(NULL, "simple-framebuffer", 0,
+						 &res, 1, &pdata, sizeof(pdata));
+	return PTR_ERR_OR_ZERO(pdev);
+}
+
+/*
  * The monitor's one interrupt. A timer that is due runs the clock event
  * handler. A preemption request marks the current task for rescheduling,
  * so the scheduler picks again on the way back to user space: this is how
@@ -1039,6 +1085,10 @@
 	BUILD_BUG_ON(offsetof(struct rewind_shared, net_enabled) != 3292);
