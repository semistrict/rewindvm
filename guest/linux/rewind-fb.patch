+	BUILD_BUG_ON(offsetof(struct rewind_shared, fb_size) != 3348);
 	rewind_publish_tasks();
 	rewind_shared.interface = REWIND_INTERFACE;
 	rewind_shared.io_buf = __pa_symbol(rewind_io_buf);
@@ -2002,6 +2052,12 @@
 		if (err)
